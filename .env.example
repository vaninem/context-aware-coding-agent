# 嵌入练习由 EmbeddingConfig.from_env() 显式读取 .env；构造对象不发网络请求。
# CHAT_* 保留给直接构造 HTTPChatModel 的示例。
CHAT_MODEL=
CHAT_BASE_URL=
CHAT_API_KEY=

# repair 命令使用 LLM_* 配置对话模型，进程环境变量优先于 --env-file。
# LLM_MODEL=ecnu-max 时自动采用约 32768 输入、8192 输出的项目工作预算。
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

EMBEDDING_BASE_URL=https://chat.ecnu.edu.cn/open/api/v1
EMBEDDING_MODEL=ecnu-embedding-small
EMBEDDING_API_KEY=
# 同一个模型别名背后的模型升级时，手工更改此版本以隔离旧向量。
EMBEDDING_REVISION=v1
EMBEDDING_BATCH_SIZE=8
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_LEASE_SECONDS=120
EMBEDDING_MAX_ATTEMPTS=3
# 可留空；ECNU 当前 ecnu-embedding-small 文档为 1024 维，其他模型不要照搬。
EMBEDDING_EXPECTED_DIMENSIONS=1024

# 文本重排只在 RAGSearchOptions(rerank=True) 时调用。
RERANK_BASE_URL=https://chat.ecnu.edu.cn/open/api/v1
RERANK_MODEL=ecnu-rerank
RERANK_API_KEY=
RERANK_TIMEOUT_SECONDS=15

# 本地 PostgreSQL＋pgvector；两处口令需保持相同，实际 .env 使用私有随机口令。
POSTGRES_USER=agent_lab
POSTGRES_DB=agent_lab
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_PORT=55432
DATABASE_URL=postgresql://agent_lab:replace-with-local-password@127.0.0.1:55432/agent_lab
DATABASE_CONNECT_TIMEOUT=10
EMBEDDING_DB_SCHEMA=agent_embeddings
# 仅供数据库集成测试：显式指定后才允许测试连接，使用独立测试库更稳妥。
# TEST_DATABASE_URL=postgresql://agent_lab:replace-with-local-password@127.0.0.1:55432/agent_lab_test
